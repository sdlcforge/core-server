{
  "name": "@sdlcforge/core-server",
  "version": "1.0.0-alpha.16",
  "description": "Implements core SDLC logic.",
  "main": "dist/sdlcforge-server.js",
  "bin": {
    "sdlcforge-server": "dist/sdlcforge-server-exec.js"
  },
  "scripts": {
    "build": "make",
    "lint": "make lint",
    "lint:fix": "make lint-fix",
    "test": "make test",
    "prepack": "make build",
    "preversion": "make test && make lint",
    "qa": "make qa",
    "start": "./scripts/start.sh",
    "stop": "./scripts/stop.sh",
    "test:local": "./scripts/test.sh",
    "test:integration": "./test/run-integration-tests.sh",
    "test:update-golden-api-spec": "UPDATE_GOLDEN_API_SPEC=true TEST=golden-api-spec make test",
    "test:update-full-tier-baseline": "UPDATE_FULL_TIER_BASELINE=true TEST=full-tier-baseline make test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [],
  "author": "Zane Rockenbaugh <zane@liquid-labs.com>",
  "license": "UNLICENSED",
  "repository": "git+ssh://git@github.com/sdlcforge/core-server.git",
  "bugs": {
    "url": "https://github.com/sdlcforge/core-server/issues"
  },
  "homepage": "https://github.com/sdlcforge/core-server#readme",
  "devDependencies": {
    "@liquid-labs/catalyst-resource-babel-and-rollup": "^1.0.0-alpha.3",
    "@liquid-labs/catalyst-resource-eslint": "^1.0.0-alpha.1",
    "@liquid-labs/catalyst-resource-jest": "^1.0.0-alpha.4",
    "supertest": "^6.3.3"
  },
  "dependencies": {
    "@liquid-labs/comply-defaults": "^1.0.0-alpha.8",
    "@liquid-labs/find-plus": "^1.0.1",
    "@liquid-labs/git-toolkit": "^1.0.0-alpha.15",
    "@liquid-labs/github-toolkit": "^1.0.0-alpha.16",
    "@liquid-labs/http-smart-response": "^1.0.0-alpha.6",
    "@liquid-labs/liq-credentials-db": "^1.0.0-alpha.9",
    "@liquid-labs/liq-handlers-lib": "^1.0.0-alpha.16",
    "@liquid-labs/liq-qa-lib": "^1.0.0-alpha.8",
    "@liquid-labs/npm-toolkit": "^1.0.0-alpha.15",
    "@liquid-labs/octocache": "^1.0.0-alpha.4",
    "@liquid-labs/plugable-express": "file:.yalc/@liquid-labs/plugable-express",
    "@liquid-labs/resource-item": "^1.0.0-alpha.4",
    "@liquid-labs/resource-model": "^1.0.0-alpha.10",
    "@liquid-labs/sdlc-projects-badges-coverage": "^1.0.0-alpha.2",
    "@liquid-labs/sdlc-projects-badges-github-workflows": "^1.0.0-alpha.2",
    "@liquid-labs/sdlc-projects-workflow-github-node-jest-cicd": "^1.0.0-alpha.2",
    "@liquid-labs/sdlc-projects-workflow-local-node-build": "^1.0.0-alpha.7",
    "@liquid-labs/shell-toolkit": "^1.0.0-alpha.7",
    "@liquid-labs/versioning": "^1.0.0-alpha.4",
    "@sdlcforge/dev-core": "file:.yalc/@sdlcforge/dev-core",
    "http-errors": "^2.0.0",
    "js-yaml": "^4.1.0"
  },
  "_comply": {
    "orgKey": "@liquid-labs"
  },
  "plugable": {
    "plugableManifestVersion": 1,
    "host": {
      "explicitPlugins": [
        "@liquid-labs/sdlc-projects-badges-coverage",
        "@liquid-labs/sdlc-projects-badges-github-workflows",
        "@liquid-labs/sdlc-projects-workflow-github-node-jest-cicd",
        "@liquid-labs/sdlc-projects-workflow-local-node-build",
        "@sdlcforge/dev-core"
      ],
      "builtins": [
        {
          "npmName": "@sdlcforge/core-server",
          "components": [
            { "component": "controls", "provides": [], "requires": [] },
            {
              "component": "credentials",
              "provides": [
                { "capability": "appExt:credentialsDB", "phase": "load", "via": "src/credentials/setup.mjs — app.ext.credentialsDB = <bare assignment>" },
                { "capability": "pathVar:credential", "phase": "load", "via": "src/credentials/setup.mjs — registerPathVar('credential')" }
              ],
              "requires": [
                "setupArg:app",
                "setupArg:cache",
                "setupArg:registerPathVar",
                "setupArg:serverConfigRoot",
                { "capability": "appExt:serverConfigRoot", "phase": "runtime", "reason": "handlers/credentials/import.mjs reads it" }
              ]
            },
            { "component": "issues-github", "provides": [], "requires": [] }
          ]
        }
      ],
      "providedCapabilities": [],
      "assumeProvided": [],
      "searchPaths": []
    }
  }
}
